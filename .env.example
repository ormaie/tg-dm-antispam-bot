# Telegram MTProto Userbot credentials (https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash
# Optional: phone number used during first interactive login
TG_PHONE=+8613800138000
# Optional: use StringSession instead of ./data/userbot.session file
TG_SESSION_STRING=

# Helper notification Bot (created via @BotFather)
BOT_TOKEN=123456789:your_bot_token_here
# Your numeric Telegram user ID (only this user can interact with the helper bot)
OWNER_ID=123456789

# OpenAI-compatible LLM endpoint
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
# Pure text model (fast & cheap, e.g., gpt-4o-mini / deepseek-chat / gemini-2.5-flash)
LLM_TEXT_MODEL=gpt-4o-mini
# Vision-capable model for images & video thumbnails (can be the same multimodal model)
LLM_VISION_MODEL=gpt-4o-mini

# Runtime paths & logging
CONFIG_PATH=config.yaml
DATA_DIR=./data
LOG_LEVEL=INFO
